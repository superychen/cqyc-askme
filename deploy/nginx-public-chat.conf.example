# 替换域名、证书和两个静态目录后，合并到实际Nginx配置；不要原样覆盖现有站点。
# API只绑定内网/loopback，Uvicorn只信任本机代理，防止伪造IP头绕过20次额度。
server {
    listen 80;
    server_name example.invalid;
    root /srv/askme/front/dist;
    client_max_body_size 21m;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 单层代理必须覆盖客户端自带的XFF，不直接拼接不可信输入。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 150s;
    }

    location = /admin { return 308 /admin/; }
    # 建议在/srv/askme/www/admin放置后台dist内容；前台使用独立root。
    location /admin/ {
        root /srv/askme/www;
        try_files $uri $uri/ /admin/index.html;
    }
    location / { try_files $uri $uri/ /index.html; }
}
