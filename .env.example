# 复制为根目录 .env 后填写；不要提交真实凭据。
APP_NAME=cqyc-askme
APP_ENV=local
LOG_LEVEL=INFO

# 登录需要账号、密码、至少 32 字符的随机密钥，以及可连接的 Redis。
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
REDIS_URL=redis://127.0.0.1:6379/0

UPLOAD_MAX_BYTES=20971520
PDF_MAX_PAGES=200
IMPORT_WORK_DIR=data/imports
PDF_TO_MD_DIR=docs/pdfToMd

# MinerU 4 自部署 V1 API，根地址不包含 /v1。
MINERU_BASE_URL=http://127.0.0.1:8001
MINERU_API_KEY=
MINERU_TIER=standard
MINERU_TIMEOUT_SECONDS=1800
PARSER_MAX_BYTES=209715200

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Infinity / 兼容服务，调用 {BASE_URL}/embeddings。
# 如果服务设置了 /v1 前缀，请将其写入 BASE_URL。
EMBEDDING_BASE_URL=http://127.0.0.1:7997
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=main
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
# 仅加载 tokenizer，不加载模型权重；默认禁止运行时自动下载。
TOKENIZER_PATH=data/models/bge-m3/tokenizer.json
TOKENIZER_LOCAL_ONLY=true
CHUNK_SIZE=700
CHUNK_MIN_SIZE=180
CHUNK_MAX_SIZE=1000
CHUNK_OVERLAP=80

# Endpoint 不带 http(s)://；存储桶需预先创建为私有桶。
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=askme-assets
MINIO_SECURE=false
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=askme_chunks_bge_m3_v1

# 公开问答：每IP永久20次（代码固定），正文最后有效对话后30天过期。
# IP_ID_SECRET 独立于管理员密钥，至少32字符；部署后不能随意轮换，否则身份/额度变化。
IP_ID_SECRET=
CHAT_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CHAT_HISTORY_TTL=2592000
CHAT_TIMEOUT=120
CHAT_PROMPT_BUDGET=24000
CHAT_OUTPUT_TOKENS=1200
RAG_TOP_K=20
ANSWER_CONTEXT_TOP_K=6

# Infinity兼容 /rerank；当前BGE-M3容器仅提供embedding，需另外加载此模型。
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 以下为调试初值，不能把分数当成正确率；上线前需用真实样本校准。
# 全部低于阈值但候选非空时，最多取 ANSWER_CONTEXT_TOP_K 条做事实复核，不直接拒答或放行。
RERANK_MIN_SCORE=0.5

# 从百炼EnhancedSearch服务的“外部调用”复制；不要使用普通WebSearch端点代替。
BAILIAN_SEARCH_MCP_URL=
BAILIAN_SEARCH_TOOL_NAME=
DASHSCOPE_API_KEY=
# 应用累计外呼预算，0表示不外呼；与账号其他项目消耗/服务商免费额度并不等同。
WEB_SEARCH_BUDGET=0
